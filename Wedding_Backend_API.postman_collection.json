{
  "info": {
    "name": "Wedding Backend API",
    "description": "Postman collection for Wedding Backend API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      },
      "response": []
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"securepassword\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/admin/login",
          "host": ["{{base_url}}"],
          "path": ["admin", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.collectionVariables.set('jwt_token', response.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": []
    },
    {
      "name": "Create Organization",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization_name\": \"My Wedding Org\",\n  \"email\": \"admin@mywedding.com\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/org/create",
          "host": ["{{base_url}}"],
          "path": ["org", "create"]
        }
      },
      "response": []
    },
    {
      "name": "Get Organization",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/org/get?organization_name=My%20Wedding%20Org",
          "host": ["{{base_url}}"],
          "path": ["org", "get"],
          "query": [
            {
              "key": "organization_name",
              "value": "My Wedding Org"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Organization",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization_name\": \"My Wedding Org\",\n  \"email\": \"newadmin@mywedding.com\",\n  \"password\": \"newpassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/org/update",
          "host": ["{{base_url}}"],
          "path": ["org", "update"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Organization",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization_name\": \"My Wedding Org\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/org/delete",
          "host": ["{{base_url}}"],
          "path": ["org", "delete"]
        }
      },
      "response": []
    }
  ]
}
